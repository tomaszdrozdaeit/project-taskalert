rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Profil użytkownika ──────────────────────────
    // Użytkownik ma pełen dostęp tylko do swoich danych
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Kategorie (globalne) ────────────────────────
    // Odczyt: każdy zalogowany użytkownik
    // Zapis: każdy zalogowany użytkownik (tworzenie nowych kategorii)
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Mail (Firebase Extension Trigger Email) ─────
    // Zapis: każdy zalogowany użytkownik (wstawianie maili)
    // Odczyt: brak (tylko Extension)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── Allowed Users (Whitelist) ───────────────────
    // Odczyt: każdy zalogowany użytkownik
    // Tworzenie/Aktualizacja/Usuwanie: tylko użytkownicy z rolą admin/super-admin
    match /allowedUsers/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.role in ['admin', 'super-admin'];
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.role in ['admin', 'super-admin']
        && resource.data.role != 'super-admin';
    }

    // ── Shared Alerts (Alerty współdzielone) ────────
    // Odczyt: zalogowany użytkownik (filtrowanie po participants po stronie klienta)
    // Tworzenie: zalogowany użytkownik
    // Aktualizacja: zalogowany użytkownik (weryfikacja roli po stronie klienta)
    // Usunięcie: zalogowany użytkownik (weryfikacja owner po stronie klienta)
    match /sharedAlerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
